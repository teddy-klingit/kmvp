enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
}

model Invoice {
  id          String        @id @default(cuid())
  clientId    String
  projectId   String?
  number      String        @unique
  amount      Float
  currency    String        @default("EUR")
  status      InvoiceStatus @default(DRAFT)
  issuedAt    DateTime?
  dueAt       DateTime?
  paidAt      DateTime?
  lineItems   Json?
  /// Phase S: the contract and period it bills, and the VAT split (amount is the total incl. VAT).
  contractId  String?
  periodStart DateTime?
  periodEnd   DateTime?
  netAmount   Float?
  vatRate     Float?
  vatAmount   Float?
  reference   String?
  createdAt   DateTime      @default(now())

  client       Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  project      Project?      @relation(fields: [projectId], references: [id])
  billingItems BillingItem[]

  @@index([contractId, periodStart])
}

enum LedgerEntryType {
  ALLOWANCE
  PURCHASE
  CONSUMPTION
  ADJUSTMENT
  /// Phase S: credits over the rollover cap, expired at the monthly grant.
  EXPIRY
  /// Phase S: a fixed-credit service's monthly reservation (never rolls over).
  SERVICE
}

model CreditLedgerEntry {
  id           String          @id @default(cuid())
  clientId     String
  projectId    String?
  /// Who it's attributed to (the approver for an estimate) and the deliverable's format, for Usage.
  userId       String?
  format       String?
  type         LedgerEntryType
  amount       Float // signed: + for allowance/purchase, - for consumption
  balanceAfter Float
  note         String?
  /// Phase S: the balance it belongs to (pm | creative); PM and creative credits are never pooled.
  pool         String          @default("creative")
  /// The month a grant, expiry or service reservation is for (YYYY-MM): makes the monthly run idempotent.
  periodKey    String?
  serviceId    String?
  createdAt    DateTime        @default(now())

  client  Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id])

  @@unique([clientId, pool, type, periodKey, serviceId])
  @@index([clientId, pool, createdAt])
}

