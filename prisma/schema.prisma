// Klingit data model.
// NOTE: datasource is sqlite for zero-install local dev (no Docker/Postgres
// available in this environment). Everything here is written to be
// Postgres-compatible — switching the provider to "postgresql" and pointing
// DATABASE_URL at a real instance is the only change needed later. The one
// SQLite constraint this schema works around is native scalar lists
// (String[]) — those are modeled as `Json` instead, which behaves the same
// in application code on both providers.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Auth (Auth.js / NextAuth PrismaAdapter shape, extended with role + profile)
// ---------------------------------------------------------------------------

enum UserRole {
  CLIENT
  INTERNAL
}

enum UserStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

model User {
  id               String     @id @default(cuid())
  name             String
  email            String     @unique
  emailVerified    DateTime?
  image            String?
  passwordHash     String?
  role             UserRole
  status           UserStatus @default(INVITED)
  twoFactorEnabled Boolean    @default(false)
  invitedAt        DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  accounts Account[]
  sessions Session[]

  clientUser  ClientUser?
  staffMember StaffMember?

  comments             Comment[]
  notifications        Notification[]
  notificationPref     NotificationPreference?
  overriddenRuns       AgentRun[]              @relation("AgentRunOverriddenBy")
  selfServiceAgentRuns AgentRun[]              @relation("AgentRunRequestedBy")
  estimateRevisions    EstimateRevision[]      @relation("EstimateRevisionCreatedBy")
  staffNotes           ProjectStaffNote[]      @relation("StaffNoteAuthor")
  decisions            DecisionLog[]           @relation("DecisionLogActor")
  brandSources         BrandSource[]           @relation("BrandSourceCreatedBy")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------------------
// Client (agency's customer org) + people
// ---------------------------------------------------------------------------

enum PlanTier {
  BASIC
  STARTER
  GROWTH
  SCALE
  ENTERPRISE
}

/// Per-plan settings an Admin can change in Settings. activeSlots = how many projects Klingit works on at once
/// for one client; the rest wait in the client's queue.
model Plan {
  tier               PlanTier @id
  activeSlots        Int
  /// Phase Q: every value below is a PLACEHOLDER until pricing is decided; editable in ops Plans & AI credits.
  name               String   @default("")
  monthlyAiCredits   Int      @default(0)
  monthlyTeamCredits Int      @default(0)
  priceAmount        Float?
  currency           String   @default("EUR")
  /// Basic: the client connects their own model (Connections); tokens are logged, never deducted.
  ownModel           Boolean  @default(false)
  sortOrder          Int      @default(0)
  updatedAt          DateTime @updatedAt
}

/// A client's plan for one monthly period (the AI-credit allowance resets each period).
model ClientPlan {
  id          String   @id @default(cuid())
  clientId    String
  tier        PlanTier
  periodStart DateTime
  periodEnd   DateTime
  createdAt   DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, periodStart])
}

enum AiLedgerKind {
  ALLOWANCE
  BUNDLE
  USAGE
  ADJUSTMENT
}

/// AI credits: LLM use by skills the client runs and built-in assistants. Never Klingit's own production AI.
/// Usage rows are written from real token counts (src/lib/ai-credits.ts). amount is signed (usage negative).
model AiCreditLedger {
  id               String       @id @default(cuid())
  clientId         String
  userId           String?
  kind             AiLedgerKind
  amount           Float
  /// usage: drawn from the monthly allowance or from bundles (bundles are used after the allowance, never expire)
  fundedBy         String?
  sourceType       String? // "skill" | "assistant"
  sourceKey        String? // Agent.key or assistant key
  sourceName       String? // "Ad gen", "Ask your data"
  projectId        String?
  format           String?
  tokensIn         Int          @default(0)
  tokensOut        Int          @default(0)
  model            String?
  /// "klingit" = counts against the client's AI credits; "client_provider" = Basic plan, their provider bills it
  billedTo         String       @default("klingit")
  /// false: logged for cost only, never counted against the client (assistants, Phase S).
  billable         Boolean      @default(true)
  /// Phase U: the real AI cost in USD (model, tokens, cache, images); costEstimated = worked out later from tokens.
  costUsd          Float?
  costEstimated    Boolean      @default(false)
  cacheReadTokens  Int          @default(0)
  cacheWriteTokens Int          @default(0)
  images           Int          @default(0)
  agentRunId       String?
  note             String?
  createdById      String?
  createdAt        DateTime     @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, createdAt])
}

/// A top-up of AI credits. Sizes and prices are PLACEHOLDERS (price null shows as "€ —").
model AiCreditBundle {
  id          String   @id @default(cuid())
  size        Int
  priceAmount Float?
  currency    String   @default("EUR")
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  requests AiTopUpRequest[]
}

/// "Buy bundle" without payment: a request staff confirm, which then writes a BUNDLE ledger row.
model AiTopUpRequest {
  id                String    @id @default(cuid())
  clientId          String
  bundleId          String
  requestedByUserId String
  status            String    @default("PENDING") // PENDING | CONFIRMED | REJECTED
  decidedByUserId   String?
  decidedAt         DateTime?
  createdAt         DateTime  @default(now())

  client Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  bundle AiCreditBundle @relation(fields: [bundleId], references: [id])
}

/// What a skill run produced, kept in the client's Output library.
model SkillOutput {
  id              String   @id @default(cuid())
  clientId        String
  agentRunId      String?
  agentId         String?
  title           String
  format          String?
  channel         String?
  text            String?
  storageKey      String?
  mimeType        String?
  createdByUserId String?
  /// Phase U: Output library category; null = mapped from the format.
  category        String?
  downloadCount   Int      @default(0)
  createdAt       DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, createdAt])
}

enum ClientStatus {
  ONBOARDING
  ACTIVE
  PAUSED
  OFFBOARDED
}

model Client {
  id                     String       @id @default(cuid())
  name                   String
  slug                   String       @unique
  industry               String?
  website                String? // e.g. "klarna.com" — powers SEO/AI-visibility audits
  competitorBrands       Json? // string[] — brand names to watch in Market Intelligence (e.g. Meta Ad Library search)
  brandSummary           String? // short blurb for the Brand Intelligence rail
  planTier               PlanTier     @default(GROWTH)
  status                 ClientStatus @default(ONBOARDING)
  /// Legacy copy of the plan's team credits, no longer read: teamAllowance() (ai-credits.ts) uses the Plan table
  /// unless staff set teamCreditsOverride.
  monthlyCreditAllowance Int          @default(0)
  /// Staff override of the plan's team credits a month (a negotiated deal); null = the plan's value. Logged in AuditLog.
  teamCreditsOverride    Int?
  creditBalance          Float        @default(0)
  healthScore            Int          @default(80) // 0-100
  /// Data sources filled with dummy data for the demo (e.g. ["LinkedIn", "Google Analytics"]). The UI labels them "demo"; there is no real connection.
  demoSources            Json?
  /// Card on file, as shown in Account. Dummy for the demo when cardIsDemo; no real payment data is ever stored.
  cardBrand              String?
  cardLast4              String?
  cardExpiry             String?
  cardIsDemo             Boolean      @default(false)
  isSampleAccount        Boolean      @default(false) // pitch/demo client — Insights shows seeded sample data styled as this client, never Klingit's own real connected ad accounts
  /// A demo account (e.g. the ouhers demo client): never reads live integrations, never runs scheduled agents,
  /// and nothing goes out from it (src/lib/notifier.ts). Seeded by prisma/seed-demo-ouhers.ts.
  isDemo                 Boolean      @default(false)
  paidMediaInScope       Boolean      @default(true) // false = this client's engagement is contractually organic-only — Performance/Reports hide all paid-ad sections rather than showing irrelevant spend/CTR data
  accountLeadId          String?
  renewalDate            DateTime?
  onboardingCompletedAt  DateTime?
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt

  accountLead StaffMember? @relation("ClientAccountLead", fields: [accountLeadId], references: [id])

  users                        ClientUser[]
  brands                       Brand[]
  projects                     Project[]
  brandOS                      BrandOS?
  invoices                     Invoice[]
  creditLedger                 CreditLedgerEntry[]
  plans                        ClientPlan[]
  aiCreditLedger               AiCreditLedger[]
  aiTopUpRequests              AiTopUpRequest[]
  skillOutputs                 SkillOutput[]
  brandRules                   BrandRule[]
  opportunities                Opportunity[]
  contracts                    Contract[]
  serviceAllocations           ServiceAllocation[]
  billingProfile               BillingProfile?
  billingItems                 BillingItem[]
  purchaseRequests             PurchaseRequest[]
  brandRuleChanges             BrandRuleChange[]
  customSkills                 Agent[]
  assets                       Asset[]
  agentRuns                    AgentRun[]
  touchpoints                  Touchpoint[]
  templates                    Template[]
  marketSignals                MarketSignal[]
  inspirations                 Inspiration[]
  notifications                Notification[]
  calendarItems                ClientCalendarItem[]
  brandAssets                  BrandAsset[]
  marketIntelligenceBrief      MarketIntelligenceBrief?
  marketIntelligenceIdeas      MarketIntelligenceIdea[]
  marketIntelligenceQuestions  MarketIntelligenceQuestion[]
  competitorSnapshots          CompetitorSnapshot[]
  competitorProfiles           CompetitorProfile[]
  trendBrief                   TrendBrief?
  performanceBenchmark         PerformanceBenchmark?
  suggestedCompetitors         SuggestedCompetitor[]
  performanceBrief             PerformanceBrief?
  siteAudits                   SiteAudit[]
  aiVisibilityChecks           AiVisibilityCheck[]
  seoBrief                     SeoBrief?
  performanceSnapshots         PerformanceSnapshot[]
  customApps                   ClientApp[]
  adDailyMetrics               AdDailyMetric[]
  contentPosts                 ContentPost[]
  followerSnapshots            FollowerSnapshot[]
  businessOutcomes             ClientBusinessOutcome[]
  contentPlanTargets           ContentPlanTarget[]
  contentPlanSuggestions       ContentPlanSuggestion[]
  reportingConfig              ClientReportingConfig?
  savedReports                 SavedReport[]
  generatedReports             GeneratedReport[]
  brandSectionDrafts           BrandSectionDraft[]
  sampleAdCampaigns            SampleAdCampaign[]
  communityManagementSnapshots CommunityManagementSnapshot[]
  internalMessages             ClientInternalMessage[]
  pmMessages                   ClientMessage[]
  outputFacts                  OutputFact[]
  audienceSnapshots            AudienceSnapshot[]
  connectedChannels            ConnectedChannel[]
  sentMessageLogs              SentMessageLog[]
  communityEscalations         CommunityEscalation[]
  websiteAnalyticsSnapshots    WebsiteAnalyticsSnapshot[]
  brandSources                 BrandSource[]
  brandConnections             BrandConnection[]
}

// AI-synthesized read of the Market Intelligence signals (news, competitor
// ads, internal performance) for one client — regenerated on demand rather
// than on every page view, so it's cached until the client asks to refresh.
model MarketIntelligenceBrief {
  id          String   @id @default(cuid())
  clientId    String   @unique
  summary     String
  assumptions Json // string[]
  generatedAt DateTime @default(now())
  /// "What this means for you": up to 2 one-liners [{text, type, actionLabel}] (Insights v2).
  points      Json?

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

enum IdeaStatus {
  NEW
  SAVED
  DISMISSED
  BRIEFED
}

// One persistent row per AI-generated creative idea, so ideas survive brief
// refreshes instead of being overwritten, and the client's Save/Dismiss/Start
// a brief actions stick — an idea already dismissed or briefed doesn't
// resurface as "new" next time the agent runs.
model MarketIntelligenceIdea {
  id        String     @id @default(cuid())
  clientId  String
  title     String
  detail    String
  status    IdeaStatus @default(NEW)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  /// Insights v2: a one-line why, evidence chips [{label}], the mini chart's bars [{label, value, unit}] and the formats it'd be made in (for the Price List estimate).
  why       String?
  evidence  Json?
  chart     Json?
  formats   Json?

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, status])
}

// Ad-hoc question a client asked the Market Intelligence agent, with its
// answer, kept as a running log (not just the last one) so the Feed tab has
// real conversational history instead of a single ephemeral Q&A.
model MarketIntelligenceQuestion {
  id        String   @id @default(cuid())
  clientId  String
  question  String
  answer    String
  createdAt DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, createdAt])
}

// Point-in-time read of one competitor's ad activity on one platform, so we
// can detect real deltas (new ads spotted, total volume up X%) instead of
// only ever showing a live snapshot. Written opportunistically when the
// Market Intelligence page loads and the last snapshot for this client is
// stale — no separate cron infra needed.
model CompetitorSnapshot {
  id         String   @id @default(cuid())
  clientId   String
  brand      String
  platform   String // "Meta" | "LinkedIn"
  totalAds   Int? // true total, only available where the platform's API reports one (LinkedIn)
  adIds      Json // string[] — ad ids/urls in this sample, for new-ad detection even without a true total
  capturedAt DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, brand, platform, capturedAt])
}

// AI-synthesized read of one competitor's positioning and messaging —
// generated from real ad samples/volume, not just a re-listing of their ads.
// Cached like the main brief; regenerated alongside it.
model CompetitorProfile {
  id            String   @id @default(cuid())
  clientId      String
  brand         String
  positioning   String // 1-2 sentence read on their current angle
  themes        Json // { theme: string; evidence: string }[]
  activityLevel String // "High" | "Medium" | "Low"
  generatedAt   DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, brand])
}

// AI-synthesized read of what's actually shaping the category right now —
// themed takeaways grounded in the news headlines on file, not just the raw
// article list.
model TrendBrief {
  id          String   @id @default(cuid())
  clientId    String   @unique
  takeaway    String
  themes      Json // { theme: string; articleTitles: string[] }[]
  generatedAt DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

enum SuggestedCompetitorStatus {
  NEW
  ADDED
  DISMISSED
}

// A brand the agent noticed repeatedly in category news but that isn't in
// Client.competitorBrands yet — surfaced for a one-click add instead of the
// client having to notice and maintain the list themselves.
model SuggestedCompetitor {
  id        String                    @id @default(cuid())
  clientId  String
  name      String
  evidence  String
  status    SuggestedCompetitorStatus @default(NEW)
  createdAt DateTime                  @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, name])
}

// AI-synthesized read of live ad-account performance across every connected
// platform plus delivered creative performance — what's actually working and
// what to do about it, not just a re-listing of campaigns.
model PerformanceBrief {
  id              String   @id @default(cuid())
  clientId        String   @unique
  summary         String
  recommendations Json // { title: string; detail: string }[]
  /// Insights Overview "This week's takeaways": { title, detail, action: { label, kind: "brief" | "view", view } }[], max 3. Null until the agent has written them.
  takeaways       Json?
  generatedAt     DateTime @default(now())
  /// "What to do" (Insights v2): up to 3 [{headline, chip, why, brief}].
  actions         Json?

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

// Point-in-time read of one live campaign's CTR, so we can detect a real
// threshold breach (CTR down vs. its own trailing average) instead of just
// showing the current number. Written opportunistically alongside the
// Performance Insights page load, staleness-guarded like CompetitorSnapshot.
/// One campaign's real activity on one day, fetched day by day from the ad platform (Meta time_increment=1,
/// Google segments.date, LinkedIn DAILY). The source for every per-day chart and sparkline in Insights; nothing
/// is ever synthesised into it.
model AdDailyMetric {
  id           String   @id @default(cuid())
  clientId     String
  platform     String // "Meta" | "LinkedIn" | "Google"
  accountName  String
  currency     String
  campaignId   String
  campaignName String
  /// The day, YYYY-MM-DD in the ad account's time zone.
  date         String
  impressions  Int
  clicks       Int
  spend        Float
  conversions  Float    @default(0)
  updatedAt    DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, platform, campaignId, date])
  @@index([clientId, date])
}

model PerformanceSnapshot {
  id           String   @id @default(cuid())
  clientId     String
  platform     String // "Meta" | "LinkedIn" | "Google"
  campaignId   String
  campaignName String
  ctr          Float
  impressions  Int
  clicks       Int
  spend        Float? // period spend — only populated where seeded/known; real-account recording doesn't set this yet
  conversions  Int? // period conversions — same caveat as spend
  capturedAt   DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, platform, campaignId, capturedAt])
}

// Seeded paid-campaign data for a pitch/demo client (Client.isSampleAccount)
// — mirrors PlatformCampaign's shape exactly so the Performance tab can
// render sample data through the same components as real ad-platform data,
// clearly labeled as sample rather than silently reusing Klingit's own
// real connected Meta/LinkedIn/Google accounts.
model SampleAdCampaign {
  id                String   @id @default(cuid())
  clientId          String
  platform          String
  accountName       String
  campaignName      String
  impressions       Int
  clicks            Int
  ctr               Float
  spend             Float
  currency          String   @default("USD")
  conversions       Int      @default(0)
  costPerConversion Float?
  createdAt         DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, platform])
}

enum ContentChannelType {
  PAID
  ORGANIC
}

enum ContentPostStatus {
  PLANNED
  PUBLISHED
}

// A single piece of content — paid or organic — on the living content
// calendar. Paid posts duplicate some of what PerformanceSnapshot already
// tracks at the campaign level; this model is post/creative-level and is
// what the calendar UI and suggestion engine actually reason over. Metrics
// are denormalized directly onto the post (one snapshot, not a time series)
// since organic posts don't accrue spend the way ad campaigns do.
model ContentPost {
  id                 String             @id @default(cuid())
  clientId           String
  platform           String // "LinkedIn" | "Instagram" | "TikTok" | "Website" | "Meta" | "Google"
  channelType        ContentChannelType
  contentType        String? // "Feed post" | "Carousel" | "Reel" | "Story" | "Short-form video" | "Static post"
  title              String
  status             ContentPostStatus  @default(PLANNED)
  scheduledDate      DateTime?
  publishedDate      DateTime?
  impressions        Int?
  reach              Int?
  engagements        Int?
  engagementRate     Float? // percent
  videoViews         Int?
  websiteClicks      Int?
  saves              Int? // SOW weekly-report metric
  shares             Int? // SOW weekly-report metric
  comments           Int?
  sourceSuggestionId String? // set when this post was created by approving a ContentPlanSuggestion, so the calendar visibly shows where it came from
  createdAt          DateTime           @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, platform, status])
}

// Weekly-report "community management summary" data (comment/DM volume,
// sentiment split, escalations) — manually seeded for now, same as
// ClientBusinessOutcome, since no real inbox/sentiment integration exists.
model CommunityManagementSnapshot {
  id                   String   @id @default(cuid())
  clientId             String
  periodStart          DateTime
  periodEnd            DateTime
  commentVolume        Int
  dmVolume             Int
  sentimentPositivePct Int
  sentimentNeutralPct  Int
  sentimentNegativePct Int
  escalations          Int      @default(0)
  /// Top comment themes for the period: [{ theme, count }].
  themes               Json?
  createdAt            DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, periodStart])
}

// Monthly-report "audience growth and demographic trends" data — per
// platform, seeded breakdowns rather than a real analytics API pull.
model AudienceSnapshot {
  id              String   @id @default(cuid())
  clientId        String
  platform        String
  ageBreakdown    Json? // [{ label, pct }]
  genderBreakdown Json? // [{ label, pct }]
  topLocations    Json? // [{ label, pct }]
  capturedAt      DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, platform])
}

// Platform follower-count time series — a separate model from ContentPost
// since follower count is a channel-level number, not tied to any one post.
model FollowerSnapshot {
  id            String   @id @default(cuid())
  clientId      String
  platform      String
  followerCount Int
  capturedAt    DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, platform, capturedAt])
}

// The client's own business results (their revenue/leads, not what they pay
// Klingit) — manually entered for now since no real CRM/ERP integration
// exists anywhere in this codebase. This is what "closes the loop" between
// content performance and actual business outcomes.
model ClientBusinessOutcome {
  id             String   @id @default(cuid())
  clientId       String
  periodStart    DateTime
  periodEnd      DateTime
  revenue        Float?
  leadsGenerated Int?
  source         String   @default("manual")
  note           String?
  createdAt      DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, periodStart])
}

// The user-set baseline plan the living calendar starts from and evolves
// against — e.g. "4 posts per week on LinkedIn."
model ContentPlanTarget {
  id           String   @id @default(cuid())
  clientId     String
  platform     String
  weeklyVolume Int
  updatedAt    DateTime @updatedAt
  createdAt    DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, platform])
}

enum ContentPlanSuggestionStatus {
  PENDING
  APPROVED
  REJECTED
}

// Where the suggestion sits in the human approval pipeline — mirrors an
// SOW-style workflow (submitted -> in review -> revised -> approved ->
// scheduled) so the UI can show visible progression, not just a card that
// disappears on click.
enum ContentPlanSuggestionStage {
  SUBMITTED
  IN_REVIEW
  REVISED
  APPROVED
  SCHEDULED
}

// An AI-proposed adjustment to the plan, grounded in real ContentPost
// performance and ClientBusinessOutcome data — surfaced for explicit
// human approval, never auto-applied. Approving one can flow into a Brief
// via briefedProjectId, mirroring the existing MarketIntelligenceIdea ->
// startBriefFromIdeaAction precedent.
model ContentPlanSuggestion {
  id                    String                      @id @default(cuid())
  clientId              String
  title                 String
  rationale             String
  platform              String?
  suggestedVolumeChange Int? // e.g. +2 or -1 posts/week on `platform`
  status                ContentPlanSuggestionStatus @default(PENDING)
  stage                 ContentPlanSuggestionStage  @default(IN_REVIEW)
  sourceCadence         String                      @default("Monthly strategy recommendation") // e.g. "Weekly trend scan" vs "Monthly strategy recommendation" — which reporting cadence this suggestion is the AI-assisted version of
  /// The day the agent proposes for it (calendar grid + "Add" schedules it there). Null on older suggestions: they show in the side card only, never on an invented date.
  proposedDate          DateTime?
  /// A few words for the side card: "stories get 3× the clicks".
  reason                String?
  briefedProjectId      String?
  createdAt             DateTime                    @default(now())
  resolvedAt            DateTime?

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, status])
}

// Per-client reporting cadence and KPI targets — how often they want
// reports and what "good" looks like per metric (e.g. Spotify's RFP: weekly
// Slack report, follower growth %, engagement rate, video views target).
model ClientReportingConfig {
  id               String   @id @default(cuid())
  clientId         String   @unique
  cadence          String   @default("WEEKLY") // WEEKLY | BIWEEKLY | MONTHLY
  kpiTargets       Json? // [{ metric, target, platform? }]
  /// Send schedule (Reports side card): ISO weekday 1–7 and "HH:MM" in Europe/Stockholm.
  sendDay          Int      @default(1)
  sendTime         String   @default("08:00")
  /// User ids of the client's team who get the report. Null = the account's owners.
  recipientUserIds Json?
  updatedAt        DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

// A named, reusable cut of the Reports page — the filter selection (date
// range, platform, content type) a client or ops user built and wants to
// come back to without re-picking it every time. The report itself is
// never stored; only the filter criteria, so reopening it always reflects
// current data for that slice.
/// A report the performance agent wrote for a closed period (Reports → Weekly / Monthly, Past reports).
/// Takeaways are grounded in what was known when it was written; top creative is stored by asset id.
model GeneratedReport {
  id          String   @id @default(cuid())
  clientId    String
  kind        String // WEEKLY | MONTHLY
  periodStart DateTime
  /// Last day of the period (inclusive).
  periodEnd   DateTime
  /// "Week 39" / "September 2026"
  label       String
  /// { title, detail }[], max 3
  takeaways   Json
  /// Delivered assets with the best measured CTR when it was written.
  topAssetIds Json
  generatedAt DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, kind, periodStart])
  @@index([clientId, kind, periodStart])
}

/// A brand agent's draft of one Brand IQ platform section ("Draft with AI" / "Rewrite with AI"). Never written
/// to Brand OS by itself: the client opens it in the editor and saves it (USED), or discards it.
model BrandSectionDraft {
  id         String    @id @default(cuid())
  clientId   String
  section    String // BRAND_PLATFORM_DOCS slug
  content    String // in the section editor's format (e.g. "Title | description" lines)
  basis      String? // what the agent based it on, shown with the draft
  status     String    @default("PENDING") // PENDING | USED | DISCARDED
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, section, status])
}

model SavedReport {
  id        String   @id @default(cuid())
  clientId  String
  name      String
  filters   Json // { dateFrom?, dateTo?, platform?, contentType? }
  createdAt DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, createdAt])
}

// One SEO/AI-crawler audit of a single site — the client's own, or a
// tracked competitor's. Real fetched signals only: on-page checks (title,
// meta description, headings, structured data) run via a direct HTML fetch;
// AI-crawler permissions read from the site's actual robots.txt; Core Web
// Vitals scores from Google's PageSpeed Insights API when configured.
model SiteAudit {
  id                 String   @id @default(cuid())
  clientId           String
  subject            String // brand name, or "Own site" for the client's own domain
  domain             String
  performanceScore   Int? // PageSpeed Insights 0-100, null if not configured
  seoScore           Int?
  accessibilityScore Int?
  bestPracticesScore Int?
  onPageChecks       Json // { hasTitle, titleLength, hasMetaDescription, metaDescriptionLength, h1Count, structuredDataTypes: string[], hasSitemap, aiCrawlerAccess: { [bot: string]: "allowed"|"blocked"|"unknown" } }
  fetchError         String? // set if the site couldn't be reached at all
  auditedAt          DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, subject])
}

// A real question put to Claude as a natural customer would ask it, checked
// afterward (deterministically, not self-reported) for which tracked brands
// actually got mentioned in the answer — a genuine, if necessarily narrow,
// proxy for AI-search visibility since we don't have access to Google AI
// Overviews / ChatGPT search results directly.
model AiVisibilityCheck {
  id        String   @id @default(cuid())
  clientId  String
  engine    String   @default("claude") // "claude" | "perplexity"
  grounded  Boolean  @default(false) // true once the answer is backed by a real web search, not just model memory
  question  String
  answer    String
  mentions  Json // { brand: string; mentioned: boolean }[]
  checkedAt DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

// AI-synthesized read of the SEO/AI-visibility audits — what to actually do
// about it, not just a score dump.
model SeoBrief {
  id              String   @id @default(cuid())
  clientId        String   @unique
  summary         String
  recommendations Json // { title: string; detail: string }[]
  generatedAt     DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

// AI-estimated category performance benchmark — explicitly an inference from
// available signals (competitor volume/positioning, category context), not
// measured third-party data. Always surfaced in the UI as an estimate.
model PerformanceBenchmark {
  id            String   @id @default(cuid())
  clientId      String   @unique
  ownFormat     String
  ownCtr        Float
  estimatedLow  Float
  estimatedHigh Float
  rationale     String
  generatedAt   DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

model Brand {
  id        String   @id @default(cuid())
  clientId  String
  name      String
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

enum ClientPermission {
  OWNER
  APPROVER
  VIEWER
}

model ClientUser {
  id         String           @id @default(cuid())
  userId     String           @unique
  clientId   String
  jobTitle   String?
  permission ClientPermission @default(VIEWER)
  createdAt  DateTime         @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  submittedBriefs    Brief[]
  comments           Comment[]               @relation("ClientUserComments")
  touchpoints        Touchpoint[]
  createdProjects    Project[]               @relation("ProjectCreatedBy")
  projectMemberships ProjectMember[]
  internalMessages   ClientInternalMessage[]
  channelReads       ProjectChannelRead[]
}

// ---------------------------------------------------------------------------
// Staff (agency's internal people)
// ---------------------------------------------------------------------------

enum InternalRole {
  ADMIN
  ACCOUNT_LEAD
  ART_DIRECTOR
  COPYWRITER
  MOTION_DESIGNER
  PROJECT_MANAGER
}

model StaffMember {
  id                   String       @id @default(cuid())
  userId               String       @unique
  title                InternalRole
  skills               Json? // string[]
  brandFitTags         Json? // string[] e.g. ["Klarna", "fintech"]
  capacityHoursPerWeek Int          @default(40)
  performanceRating    Float        @default(4.5) // 0-5, from past project reviews
  /// Phase U: "Book a call" in the client's message panel.
  bookingUrl           String?
  /// Phase T: can open Admin (set-up, prices, billing, migration). Separate from the title, so a PM can be an admin.
  isAdmin              Boolean      @default(false)
  createdAt            DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  leadClients         Client[]     @relation("ClientAccountLead")
  contactContracts    Contract[]   @relation("ContractContact")
  teamMemberships     TeamMember[]
  sentEstimates       Estimate[]
  proposedTeams       Team[]
  publishedClientApps ClientApp[]
}

// ---------------------------------------------------------------------------
// Pipeline: Project + its 10 stages
// ---------------------------------------------------------------------------

enum PipelineStageName {
  BRIEF
  ESTIMATE
  STAFFING
  PRODUCTION
  QA
  FIRST_DRAFT_DELIVERY
  FEEDBACK
  FINAL_DELIVERY
  ARCHIVE_LEARN_MEASURE
  SUGGESTIONS
}

enum StageStatus {
  UPCOMING
  ACTIVE
  COMPLETED
  SKIPPED
}

enum ProjectStatus {
  DRAFT // client (and their team) is still shaping the brief — not yet visible to the Klingit ops side
  BRIEFING
  ESTIMATING
  STAFFING
  IN_PRODUCTION
  QA
  AWAITING_REVIEW
  IN_FEEDBACK
  DELIVERED
  PAUSED
  ARCHIVED
}

// A project is not always an ad campaign — it can be a single asset, a deck,
// a motion piece, a dev/build request, brand work, or something else the
// client asks for. Brief copy and deliverable options adapt to this.
enum ProjectType {
  CAMPAIGN
  SINGLE_ASSET
  PRESENTATION
  MOTION_VIDEO
  DEVELOPMENT
  BRAND_GUIDELINES
  OTHER
}

model Project {
  id                      String         @id @default(cuid())
  clientId                String
  name                    String
  type                    ProjectType    @default(CAMPAIGN)
  status                  ProjectStatus  @default(BRIEFING)
  pausedFromStatus        ProjectStatus? // status to restore to on resume — only set while status = PAUSED
  dueDate                 DateTime?
  startedAt               DateTime?
  deliveredAt             DateTime?
  creditsQuoted           Float?
  creditsActual           Float?
  priceAmount             Float?
  priceCurrency           String         @default("EUR")
  // Confidential projects are hidden from other client-side teammates —
  // visible only to the creator and the ClientUsers added as members below.
  // This is a client-internal privacy boundary; it never restricts Klingit ops.
  confidential            Boolean        @default(false)
  // Autopilot runs the automatic steps (brief accept, estimate send, staffing). Pausing stops them; unpausing doesn't replay.
  autopilot               Boolean        @default(true)
  autopilotPausedAt       DateTime?
  autopilotPausedByUserId String?
  // Active slots: a project holds one from activation (estimate approved and a slot free) until sign-off.
  // Until then it waits in the client's queue, in queuePosition order (the client can reorder it).
  activatedAt             DateTime?
  queuePosition           Int?
  /// An agent build the client requested from Brand OS → Agents & templates ("Being built for you").
  agentBuild              Boolean        @default(false)
  createdByClientUserId   String?
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt

  client    Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdBy ClientUser? @relation("ProjectCreatedBy", fields: [createdByClientUserId], references: [id], onDelete: SetNull)

  pipelineStages   PipelineStage[]
  brief            Brief?
  estimate         Estimate?
  team             Team?
  assets           Asset[]
  comments         Comment[]
  agentRuns        AgentRun[]
  notifications    Notification[]
  invoices         Invoice[]
  creditLedger     CreditLedgerEntry[]
  changeRequests   ChangeRequest[]
  internalMessages ClientInternalMessage[]
  channelReads     ProjectChannelRead[]
  members          ProjectMember[]
  staffNotes       ProjectStaffNote[]
  decisions        DecisionLog[]
}

// Grants a specific client teammate access to a project — used both to invite
// collaborators onto a project's team and, when the project is confidential,
// as the allowlist of who besides the creator can see it.
model ProjectMember {
  id           String   @id @default(cuid())
  projectId    String
  clientUserId String
  addedAt      DateTime @default(now())

  project    Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  clientUser ClientUser @relation(fields: [clientUserId], references: [id], onDelete: Cascade)

  @@unique([projectId, clientUserId])
}

model PipelineStage {
  id          String            @id @default(cuid())
  projectId   String
  name        PipelineStageName
  order       Int
  status      StageStatus       @default(UPCOMING)
  startedAt   DateTime?
  completedAt DateTime?
  etaAt       DateTime?
  summary     String?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, name])
}

// ---------------------------------------------------------------------------
// Brief
// ---------------------------------------------------------------------------

enum BriefStatus {
  DRAFT
  SUBMITTED
  GAPS_FLAGGED
  ACCEPTED
}

model Brief {
  id                  String      @id @default(cuid())
  projectId           String      @unique
  submittedByUserId   String?
  goals               String?
  targetAudience      String?
  successMetrics      String?
  toneTags            Json? // string[]
  keyMessage          String?
  references          String?
  deliverablesNotes   String?
  emphasizedColors    Json? // hex[] selected from Brand IQ during intake
  rawIntake           String? // the client's original free-text brief
  sourceLink          String? // optional link to a doc/deck they shared
  sourceFileName      String? // optional file they attached
  pendingQuestions    Json? // AI-generated clarifying questions: [{key, question, quickAnswers: string[]}]
  transcript          Json? // conversational Q&A turns: [{key, question, answer}]
  gapsFlagged         Json? // string[]
  followUpSuggestions Json? // string[] — quick-tap replies the client can send their team about the flagged gaps
  aiSummary           String? // Brief agent's structured summary of the brief
  aiQualityScore      Int? // Brief agent's 0-100 completeness/clarity score
  // Brief studio (Phase K): the live brief as sections [{key, value, items?, refs?, source, sourceRef?, editedByClient}],
  // the deterministic briefQuality() score, the questions the agent asked [{id, key, question, type, options,
  // recommendedOptionIds, chosen, ...}] and the studio conversation [{id, role, text, at, ...}].
  sections            Json?
  qualityScore        Int?
  questionsLog        Json?
  messages            Json?
  // The brief agent's drafted chips (message options, barriers, proof points) and The task's inputs, kept between turns.
  agentDrafts         Json?
  status              BriefStatus @default(DRAFT)
  submittedAt         DateTime?
  acceptedAt          DateTime?
  createdAt           DateTime    @default(now())

  project         Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  submittedByUser ClientUser?     @relation(fields: [submittedByUserId], references: [id])
  revisions       BriefRevision[]
}

// A snapshot of the brief's editable fields taken right before an edit is
// applied to an already-accepted brief — the version-control trail so the
// team can see exactly what the brief said at any point in time.
model BriefRevision {
  id             String   @id @default(cuid())
  briefId        String
  goals          String?
  targetAudience String?
  successMetrics String?
  references     String?
  changedByName  String
  createdAt      DateTime @default(now())

  brief Brief @relation(fields: [briefId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Estimate
// ---------------------------------------------------------------------------

enum EstimateStatus {
  DRAFT
  SENT
  APPROVED
  CHANGES_REQUESTED
  EXPIRED
}

model Estimate {
  id              String         @id @default(cuid())
  projectId       String         @unique
  sentByStaffId   String?
  status          EstimateStatus @default(DRAFT)
  totalHours      Float          @default(0)
  totalCredits    Float          @default(0)
  /// Phase S: the split of totalCredits between the PM and the creative balance.
  pmCredits       Float          @default(0)
  creativeCredits Float          @default(0)
  currency        String         @default("EUR")
  totalPrice      Float?
  notes           String?
  sentAt          DateTime?
  expiresAt       DateTime?
  respondedAt     DateTime?
  // Current version shown to the client. v(n+1) is created when a PM edits an estimate the client already has.
  version         Int            @default(1)
  // The "Reason for the client" attached to the current version (v2+).
  revisionReason  String?
  // Last version the client approved; stays in force if they decline a revision.
  approvedVersion Int?
  createdAt       DateTime       @default(now())

  project         Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sentByStaff     StaffMember?       @relation(fields: [sentByStaffId], references: [id])
  lineItems       EstimateLineItem[]
  revisions       EstimateRevision[]
  inclusions      Json? // string[]
  // Deliverables the Estimate agent flagged as having no matching Price List
  // entry — it must never invent a cost for these; a human prices them
  // manually before the estimate is considered complete.
  unresolvedNeeds Json? // {description, reason}[]
}

// ---------------------------------------------------------------------------
// Price list — the agency's rate card, keyed by deliverable type + how
// complex that instance of it is. This is what the Estimate agent prices
// line items against instead of guessing hours itself.
// ---------------------------------------------------------------------------

enum ComplexityTier {
  LOW
  MEDIUM
  HIGH
}

model PriceListItem {
  id               String             @id @default(cuid())
  /// The item's name (for Price List rows from the 2026 sheet, the same as displayName).
  deliverableType  String
  displayName      String?
  /// Phase S: the sheet's category and squad.
  category         String?
  squad            String?
  /// What one unit is: "per post", "per slide", "per month"…
  unit             String?
  /// Only on the old tiered rows (archived); the 2026 list has one fixed number per item.
  complexityTier   ComplexityTier?
  /// Credits per unit (fractional, e.g. 0.5). Null on a quote item: the PM sets the number.
  creditCost       Float?
  /// Which balance the item draws on: creative (default) or pm.
  balance          String             @default("creative")
  /// fixed: used as is · estimate: a starting point the PM confirms · quote: no number, the PM quotes · legacy: staff reference only.
  status           String             @default("fixed")
  /// A monthly fixed-credit service (Performance via Druce, the web retainer): reserved each month, never rolls over.
  monthly          Boolean            @default(false)
  notes            String?
  /// Business days from staffing to final delivery; blank when unknown (Plan falls back to its per-format table).
  leadTimeDays     Int?
  /// Hidden items (legacy) are never shown to clients or offered to the Estimate agent.
  visibleToClients Boolean            @default(true)
  version          Int                @default(1)
  validFrom        DateTime           @default(now())
  /// Slug of the sheet's item name (data/pricing/klingit-price-list-credits-2026.csv).
  sourceKey        String?            @unique
  sortOrder        Int                @default(0)
  /// Soft archive ("Remove" on the price list): hidden from the list and from new estimates; old estimate lines keep their link.
  archivedAt       DateTime?
  lineItems        EstimateLineItem[]
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([deliverableType])
}

model EstimateLineItem {
  id                 String          @id @default(cuid())
  estimateId         String
  deliverable        String
  detail             String
  hours              Float
  // Always computed on the server: quantity × Price List cost, or the stated credits on a custom line.
  credits            Float
  order              Int             @default(0)
  quantity           Int             @default(1)
  complexityTier     ComplexityTier?
  priceListItemId    String?
  isCustom           Boolean         @default(false)
  customReason       String?
  /// Phase S: the balance this line draws on (pm | creative).
  balance            String          @default("creative")
  /// An estimate or quote item (or a PM quote): the estimate can't be sent until the PM confirms the number.
  needsConfirm       Boolean         @default(false)
  confirmedAt        DateTime?
  confirmedByStaffId String?
  /// For a custom PM quote: the task type whose multiplier turned hours into credits.
  taskType           String?

  estimate      Estimate       @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  priceListItem PriceListItem? @relation(fields: [priceListItemId], references: [id], onDelete: SetNull)
}

/// Snapshot of each estimate version the client was sent: lines, total, reason, who/when, and the client's answer.
model EstimateRevision {
  id              String    @id @default(cuid())
  estimateId      String
  version         Int
  lineItems       Json // {deliverable, detail, quantity, complexityTier, credits, isCustom, customReason}[]
  totalCredits    Int
  reason          String?
  createdByUserId String?
  status          String    @default("SENT") // SENT | APPROVED | DECLINED | SUPERSEDED
  respondedAt     DateTime?
  createdAt       DateTime  @default(now())

  estimate  Estimate @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  createdBy User?    @relation("EstimateRevisionCreatedBy", fields: [createdByUserId], references: [id])

  @@unique([estimateId, version])
}

// ---------------------------------------------------------------------------
// Team / Staffing
// ---------------------------------------------------------------------------

model Team {
  id                String    @id @default(cuid())
  projectId         String    @unique
  proposedByStaffId String?
  confirmed         Boolean   @default(false)
  confirmedAt       DateTime? // starts the first-draft clock (committed: within 2 business days)
  createdAt         DateTime  @default(now())

  project         Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  proposedByStaff StaffMember? @relation(fields: [proposedByStaffId], references: [id])
  members         TeamMember[]
}

model TeamMember {
  id             String  @id @default(cuid())
  teamId         String
  staffMemberId  String
  roleOnProject  String
  recommended    Boolean @default(false)
  allocatedHours Float   @default(0)

  team        Team        @relation(fields: [teamId], references: [id], onDelete: Cascade)
  staffMember StaffMember @relation(fields: [staffMemberId], references: [id])

  @@unique([teamId, staffMemberId])
}

// ---------------------------------------------------------------------------
// Assets / feedback
// ---------------------------------------------------------------------------

enum AssetType {
  IMAGE
  VIDEO
  COPY
  HTML5
}

enum AssetStatus {
  IN_REVIEW
  APPROVED
  CHANGES_REQUESTED
  DELIVERED
  ARCHIVED
}

model Asset {
  id                 String      @id @default(cuid())
  projectId          String
  clientId           String
  name               String
  format             String // e.g. "Story 9:16", "Static 1:1"
  platform           String? // e.g. "Instagram", "TikTok", "Facebook", "Display Network"
  type               AssetType   @default(IMAGE)
  fileUrl            String?
  // Uploaded file, stored under UPLOADS_DIR (/data/uploads on Railway) and served through an access-checked route.
  storageKey         String?
  mimeType           String?
  sizeBytes          Int?
  uploadedByUserId   String?
  // Times the client asked for changes; the second one is a PM exception.
  changeRequestCount Int         @default(0)
  thumbnailColor     String      @default("var(--avatar-3)") // fixture placeholder swatch
  durationSeconds    Int? // set for VIDEO assets — drives the mock player's scrubber length
  status             AssetStatus @default(IN_REVIEW)
  /// The latest version number (any state; staff see it in the quality check).
  version            Int         @default(1)
  /// The version the client has, or null if nothing was ever sent: a null asset is invisible to clients
  /// (src/lib/qc/visibility.ts). The file fields above always hold this version's file once it's set.
  sentVersion        Int?
  performanceCtr     Float?
  performanceScore   Int?
  /// Views (video / social), when that's the asset's main number rather than CTR.
  performanceViews   Int?
  tags               Json?
  /// Phase U: Output library category (Social, Ads, Presentations…); null = mapped from format and project type.
  category           String?
  downloadCount      Int         @default(0)
  /// A preview image (first slide or page) for work the browser can't show, e.g. a PPTX.
  previewKey         String?
  createdAt          DateTime    @default(now())

  project  Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  client   Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  comments Comment[]
  versions AssetVersion[]
}

/// draft → checking → qc_ready (Klingit only) → sent_to_client → approved / changes_requested.
/// A client never sees a version before SENT_TO_CLIENT (src/lib/qc/visibility.ts).
enum AssetVersionState {
  DRAFT
  CHECKING
  QC_READY
  SENT_TO_CLIENT
  APPROVED
  CHANGES_REQUESTED
}

/// One uploaded file of an asset. The Brand OS check runs on every new version (src/lib/qc/brand-check.ts).
model AssetVersion {
  id               String            @id @default(cuid())
  assetId          String
  projectId        String
  number           Int
  state            AssetVersionState @default(DRAFT)
  storageKey       String?
  mimeType         String?
  sizeBytes        Int?
  fileUrl          String?
  width            Int?
  height           Int?
  uploadedByUserId String?
  /// The checks that ran: [{ key, label, source, passed }]. Staff only; clients get labels via the chip.
  checks           Json?
  checkRunId       String?
  checkedAt        DateTime?
  // Video only: read from the file on upload (MP4 header) and the browser (poster, strip).
  durationSeconds  Float?
  fps              Float?
  hasAudio         Boolean?
  posterKey        String?
  thumbStripKey    String?
  sentAt           DateTime?
  sentByUserId     String?
  createdAt        DateTime          @default(now())

  asset Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  flags QcFlag[]

  @@unique([assetId, number])
  @@index([projectId, state])
}

enum QcFlagStatus {
  OPEN
  SENT_TO_DESIGNER
  ACCEPTED
}

/// A failed check on one version. Staff only: never shown or counted on a client screen.
model QcFlag {
  id               String       @id @default(cuid())
  versionId        String
  projectId        String
  checkKey         String
  /// Short, under the cell: "Text crop".
  label            String
  /// One line in the panel: "headline is cropped".
  detail           String
  /// Where the rule comes from: "Size check", "Brand OS · voice rules".
  source           String
  status           QcFlagStatus @default(OPEN)
  /// Required to accept as is; logged in the decision log too.
  reason           String?
  /// Raised after the version was sent (e.g. the Brand OS changed): goes to the PM, never the client.
  late             Boolean      @default(false)
  resolvedByUserId String?
  resolvedAt       DateTime?
  createdAt        DateTime     @default(now())

  version AssetVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@index([projectId, status])
}

enum CommentKind {
  MESSAGE
  SYSTEM
}

model Comment {
  id                  String      @id @default(cuid())
  projectId           String
  assetId             String?
  authorUserId        String?
  authorClientUserId  String?
  body                String
  resolved            Boolean     @default(false)
  agentPriority       String? // "High" | "Medium" | "Low" — set by the Feedback agent
  agentTaskSummary    String? // Feedback agent's structured task description
  xPercent            Float? // pin (or region top-left) position on the asset preview, 0-100 — null = a general (unpinned) comment
  yPercent            Float?
  widthPercent        Float? // set only for a drawn region comment (Figma-style marquee), not a single point pin
  heightPercent       Float?
  timestampSeconds    Float? // set only for a video/motion asset comment — the moment in playback being referenced
  timestampEndSeconds Float? // set for a range on a video (timestampSeconds → timestampEndSeconds)
  archivedAt          DateTime? // soft delete — archived comments are hidden everywhere but kept for restore
  // SYSTEM rows are project events shown as centred chips ("Estimate v1 sent").
  kind                CommentKind @default(MESSAGE)
  // What the message is about, for the context chip: e.g. contextKind
  // "estimate_line", contextRef = line item id, contextLabel shown verbatim.
  contextKind         String?
  contextRef          String?
  contextLabel        String?
  /// Phase U: files sent with the message: [{ name, storageKey, mimeType, size }].
  attachments         Json?
  createdAt           DateTime    @default(now())

  project      Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  asset        Asset?      @relation(fields: [assetId], references: [id], onDelete: Cascade)
  author       User?       @relation(fields: [authorUserId], references: [id])
  clientAuthor ClientUser? @relation("ClientUserComments", fields: [authorClientUserId], references: [id])
}

// The client org's own back-channel on a project. Never readable by Klingit
// staff — only src/lib/internal-messages.ts may query this table.
model ClientInternalMessage {
  id                 String    @id @default(cuid())
  projectId          String
  clientId           String
  authorClientUserId String
  body               String
  archivedAt         DateTime?
  createdAt          DateTime  @default(now())

  project Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  client  Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  author  ClientUser @relation(fields: [authorClientUserId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
}

enum ConversationChannel {
  KLINGIT
  INTERNAL
}

// Drives the unread dot per conversation channel, per client user.
model ProjectChannelRead {
  id           String              @id @default(cuid())
  clientUserId String
  projectId    String
  channel      ConversationChannel
  lastReadAt   DateTime

  clientUser ClientUser @relation(fields: [clientUserId], references: [id], onDelete: Cascade)
  project    Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([clientUserId, projectId, channel])
}

model ChangeRequest {
  id          String   @id @default(cuid())
  projectId   String
  description String
  status      String   @default("SUBMITTED") // SUBMITTED, SCOPING, APPROVED, DECLINED
  createdAt   DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Agents
// ---------------------------------------------------------------------------

enum AgentCategory {
  FOUNDATION
  BRIEF
  ESTIMATE
  STAFFING
  PRODUCTION
  QA
  DELIVERY
  FEEDBACK
  ARCHIVE
}

enum AgentStatus {
  LIVE
  SANDBOX
  DISABLED
  ERROR
}

enum AgentKind {
  SKILL
  ASSISTANT
  INTERNAL
}

/// The AI catalog. Client-facing it is never "agent": kind SKILL = skills clients run (standard, or custom with a
/// clientId), ASSISTANT = built-in helpers (Brief assistant, Ask your data, …), INTERNAL = Klingit's production
/// automation (estimate, staffing, QC). Table and model keep their internal name.
model Agent {
  id                  String        @id @default(cuid())
  key                 String        @unique // "brand_os", "brief_agent", "ad_gen", ...
  name                String
  category            AgentCategory
  description         String
  status              AgentStatus   @default(LIVE)
  version             String        @default("1.0.0")
  costPerRunCredits   Float?
  selfService         Boolean       @default(false) // true = the client can run this themselves from Brand IQ, not just Klingit staff internally
  kind                AgentKind     @default(INTERNAL)
  /// A custom skill built for one client; null = standard (every client).
  clientId            String?
  /// Run a skill category chip: Copy | Visual | Social | Briefs
  skillCategory       String?
  /// ≈ AI credits per run shown before a run (PLACEHOLDER until measured).
  aiCreditsPerRun     Float?
  /// One line under the skill's name.
  summary             String?
  /// Skills page label (Phase R): "self_service" (the client runs it, AI credits), "klingit_run" (the client asks,
  /// Klingit does it, team credits) or "custom" (the client's own). Null = not shown to clients (internal, assistants).
  availability        String?
  /// Skills page group: "make_ad" | "write_copy" | "plan_brief". Editable by staff in /ops/skills.
  goal                String?
  /// Staff-picked example outputs for the skill card when the client has none of their own: [{ title, text?, color }].
  examples            Json?
  /// Run by Klingit: ≈ team credits for one request (a placeholder until priced).
  teamCreditsEstimate Float?
  createdAt           DateTime      @default(now())

  runs   AgentRun[]
  client Client?    @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

enum AgentRunStatus {
  SUCCESS
  FAILED
  FLAGGED
}

model AgentRun {
  id                 String         @id @default(cuid())
  agentId            String
  projectId          String?
  clientId           String?
  input              Json?
  output             Json?
  decision           String?
  status             AgentRunStatus @default(SUCCESS)
  overridden         Boolean        @default(false)
  overriddenByUserId String?
  overrideReason     String?
  requestedByUserId  String? // set when a client ran a self-service agent themselves, rather than an internal pipeline run
  durationMs         Int?
  /// Real token use from the provider's response, and the AI credits it cost the client (null = not charged).
  tokensIn           Int?
  tokensOut          Int?
  model              String?
  aiCredits          Float?
  /// Phase U: the run's real AI cost in USD.
  costUsd            Float?
  createdAt          DateTime       @default(now())

  agent            Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  project          Project? @relation(fields: [projectId], references: [id])
  client           Client?  @relation(fields: [clientId], references: [id])
  overriddenByUser User?    @relation("AgentRunOverriddenBy", fields: [overriddenByUserId], references: [id])
  requestedByUser  User?    @relation("AgentRunRequestedBy", fields: [requestedByUserId], references: [id])
}

// ---------------------------------------------------------------------------
// Brand OS
// ---------------------------------------------------------------------------

model BrandOS {
  id                   String    @id @default(cuid())
  clientId             String    @unique
  toneRules            Json?
  dos                  Json?
  donts                Json?
  approvedColors       Json?
  approvedTypography   Json?
  figmaSyncConfig      Json?
  /// Deprecated (Phase J): stored brand-health numbers. Not read or seeded any more; Brand IQ computes
  /// health from what's written (src/lib/brand-completeness.ts). Kept so no data is deleted.
  foundationPct        Int       @default(0)
  figmaLibraryPct      Int       @default(0)
  assetArchivePct      Int       @default(0)
  qualityBenchmarksPct Int       @default(0)
  indexedAssetsCount   Int       @default(0)
  brandOsRulesCount    Int       @default(0)
  toneGuidelinesCount  Int       @default(0)
  lastSyncedAt         DateTime?
  updatedAt            DateTime  @updatedAt

  // Full brand profile — everything about the brand beyond raw campaign
  // guidelines, so Brand IQ reads like a real brand portal (Frontify-style).
  valueProposition  String?
  keyProducts       Json? // string[]
  audiencePersonas  Json? // [{name, description, ageRange, traits: string[]}]
  voiceAttributes   Json? // [{label, leftLabel, rightLabel, value 0-100}]
  imageryStyle      String?
  illustrationStyle String?
  competitiveNote   String?

