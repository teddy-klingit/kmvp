/// Klingit-only notes on a project. Never readable by clients: only src/lib/staff-notes.ts may query this table.
model ProjectStaffNote {
  id           String    @id @default(cuid())
  projectId    String
  authorUserId String
  body         String
  archivedAt   DateTime?
  createdAt    DateTime  @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author  User    @relation("StaffNoteAuthor", fields: [authorUserId], references: [id])

  @@index([projectId, createdAt])
}

/// Every PM edit and automatic step: who, what, before → after, reason, and the agent run it overrides (if any).
enum BrandRuleType {
  TONE
  DO
  WORDS_USE
  WORDS_AVOID
  CLAIMS
  CHANNEL
}

enum BrandRuleStatus {
  ACTIVE
  SUGGESTED
  DRAFT
  DECLINED
}

/**
 * Brand OS → Rules (Phase R): what every skill, assistant and quality check follows. ACTIVE rules apply (when
 * `active`); SUGGESTED come from members and DRAFT from a guidelines import, both waiting for an admin. Word lists
 * are WORDS_USE / WORDS_AVOID rules with `words` (the one per type with source "word_list" holds the chips).
 * Deleting sets deletedAt so a change can be undone. Read only through brand-rules.ts.
 */
model BrandRule {
  id                String          @id @default(cuid())
  clientId          String
  type              BrandRuleType
  text              String
  /// Words matched as whole words (word lists, and the words a "never say …" rule names).
  words             Json?
  /// Where it applies: { channels?: string[], products?: string[] }; none = everywhere.
  scope             Json?
  active            Boolean         @default(true)
  status            BrandRuleStatus @default(ACTIVE)
  /// "brand_os" (copied from the old fields), "manual", "suggestion", "word_list", "import:<file name>", "seed".
  source            String          @default("manual")
  sortOrder         Int             @default(0)
  /// From the shared rule check (checkCopy): times it applied, and times it caught something. Never invented.
  usedCount         Int             @default(0)
  caughtCount       Int             @default(0)
  createdByUserId   String?
  suggestedByUserId String?
  deletedAt         DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, status])
}

/// Every change to a client's rules (who, when, before/after), shown in Change history; a change can be undone.
model BrandRuleChange {
  id          String    @id @default(cuid())
  clientId    String
  ruleId      String?
  actorUserId String?
  /// A Klingit staff member made it ("· Klingit").
  byKlingit   Boolean   @default(false)
  /// added | edited | deactivated | activated | deleted | suggested | approved | declined | imported | undone
  action      String
  summary     String
  before      Json?
  after       Json?
  undoneAt    DateTime?
  createdAt   DateTime  @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, createdAt])
}

/// How long Klingit usually needs per format, in working days (brief-by dates), and a rough team-credit estimate.
/// Staff edit both in /ops/settings; both are placeholders until measured.
model PlanLeadTime {
  id           String   @id @default(cuid())
  format       String   @unique
  workingDays  Int
  teamCredits  Float?
  /// The Price List item whose lead time wins over workingDays (Phase S).
  priceListKey String?
  sortOrder    Int      @default(0)
  updatedAt    DateTime @updatedAt
}

/// Holidays and shopping days per market (SE / NO / DK / FI) for Plan's Key moments layer. Staff-editable.
model KeyMoment {
  id        String    @id @default(cuid())
  date      DateTime
  endDate   DateTime?
  name      String
  /// ["SE","NO","DK","FI"]
  markets   Json
  /// "holiday" | "shopping"
  kind      String    @default("holiday")
  createdAt DateTime  @default(now())

  @@index([date])
}

/// A private iCal feed of a user's plan (Plan → Subscribe). Revoking sets revokedAt; the URL stops working.
model PlanFeedToken {
  id        String    @id @default(cuid())
  userId    String
  clientId  String
  token     String    @unique
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  @@index([userId])
}

/// Staff and admin changes that aren't tied to a project: who owns a live ad account, a client's own AI key
/// (added / replaced / removed, never the key itself). Kept when a client goes (plain ids, no relations).
model AuditLog {
  id          String   @id @default(cuid())
  clientId    String?
  actorUserId String?
  /// "ad-accounts" | "ai-keys"
  area        String
  action      String
  before      Json?
  after       Json?
  createdAt   DateTime @default(now())

  @@index([clientId, createdAt])
  @@index([area, createdAt])
}

model DecisionLog {
  id          String   @id @default(cuid())
  projectId   String
  actorUserId String? // null = autopilot
  area        String // brief | estimate | staffing | dates | assets | autopilot
  action      String
  before      Json?
  after       Json?
  reason      String?
  agentRunId  String?
  createdAt   DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actor   User?   @relation("DecisionLogActor", fields: [actorUserId], references: [id])

  @@index([projectId, createdAt])
}

/// A link to where the client's brand material lives (Drive file, Figma library, any URL), optionally pinned
/// to one Brand OS section. Agents get the title, app and URL as reference; contents are never fetched.
model BrandSource {
  id              String    @id @default(cuid())
  clientId        String
  app             String // google_drive | figma | notion | dropbox | sharepoint | canva | frameio | slack | web
  url             String
  title           String
  section         String? // Brand OS section slug (our-brand, vision, …, visual-identity, figma-design-system); null = library only
  isDemo          Boolean   @default(false) // picked from a demo connection: the file isn't real yet
  createdByUserId String?
  archivedAt      DateTime? // soft delete — removing a chip archives it
  createdAt       DateTime  @default(now())

  client    Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdBy User?  @relation("BrandSourceCreatedBy", fields: [createdByUserId], references: [id])

  @@index([clientId, section])
}

/// A connected app. MVP: every connection is a demo (no OAuth, nothing synced), labelled as such everywhere.
model BrandConnection {
  id          String    @id @default(cuid())
  clientId    String
  app         String
  status      String    @default("CONNECTED") // CONNECTED | DISCONNECTED | NEEDS_RECONNECT
  /// Connections page detail: { folders, accounts, lastSyncAt, note } and, for "your own AI model", the key.
  meta        Json?
  connectedAt DateTime?
  isDemo      Boolean   @default(true)
  createdAt   DateTime  @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, app])
}

/// Plan → Opportunities (Phase R, designs 06–07): one object for what used to be Insights ideas, calendar suggestions
/// and project inspiration. Evidence items come from real data (Insights, the Market feed, the key-moments table);
/// demo evidence says so. Written by the weekly scan (Klingit's cost), "Ask for more" (the client's AI credits) or
/// staff in /ops, who can review, edit and hide them.
model Opportunity {
  id                String    @id @default(cuid())
  clientId          String
  title             String
  summary           String
  /// The card's one line: why now.
  whyNow            String?
  /// seasonal | data | trend | competitor
  sources           Json      @default("[]")
  /// [{value, text, source, kind, ref?, demo?}] — at most 3 shown.
  evidence          Json      @default("[]")
  /// One small chart for "Why we suggest it": {title, subtitle?, bars: [{label, value}], highlight?, source}.
  chart             Json?
  windowStart       DateTime?
  windowEnd         DateTime?
  /// When there's no window: "Any time · sooner is better".
  windowNote        String?
  fitsProjectId     String?
  fitsLabel         String?
  /// The self-service skill that could make it ("Make it with a skill").
  skillKey          String?
  /// Where the chart that produced it lives in Insights, so Insights can link back.
  insightHref       String?
  /// new | added | briefed | live | dismissed
  status            String    @default("new")
  dismissReason     String?
  dismissedAt       DateTime?
  dismissedByUserId String?
  /// weekly | ask | staff | migrated | seed
  origin            String    @default("weekly")
  reviewedByUserId  String?
  reviewedAt        DateTime?
  /// Hidden by staff: never shown to the client.
  hiddenAt          DateTime?
  /// What it was made from (idea:<id>, suggestion:<id>, inspiration:<id>, moment:<id>…): never suggested twice.
  sourceKey         String?
  isDemo            Boolean   @default(false)
  createdByUserId   String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  client Client             @relation(fields: [clientId], references: [id], onDelete: Cascade)
  routes OpportunityRoute[]

  @@unique([clientId, sourceKey])
  @@index([clientId, status])
}

/// One way to do an opportunity (2–3 each): a sample line in the client's voice, run through the rule check.
model OpportunityRoute {
  id              String   @id @default(cuid())
  opportunityId   String
  letter          String
  name            String
  description     String
  formats         Json     @default("[]")
  channels        Json     @default("[]")
  sampleLine      String?
  /// The rule check's result for the sample line: {ok, violations: [{rule, words}]}.
  sampleCheck     Json?
  teamCreditsLow  Int?
  teamCreditsHigh Int?
  aiCredits       Int?
  /// new | added | briefed | live | dismissed
  status          String   @default("new")
  planItemId      String?
  projectId       String?
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())

  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@index([opportunityId])
}

/// Staff-editable platform settings (Phase S): one row per key, the value as JSON. Placeholders until set.
model PlatformSetting {
  key             String   @id
  value           Json
  updatedByUserId String?
  updatedAt       DateTime @updatedAt
}

/// Phase S: what a client pays for the platform (EUR per month, placeholders, staff-editable). A contract locks the
/// price at signing, so editing a plan never changes what an existing client pays.
model PlatformPlan {
  key               String   @id // basic | pro | enterprise
  name              String
  priceEur          Float
  aiCreditsPerMonth Int
  /// Phase U: the plan's AI budget per month in USD; the credits follow (budget ÷ the $ per credit setting).
  aiBudgetUsd       Float?
  /// Basic: the client's own AI (Claude via MCP or their key); their provider bills it.
  ownModel          Boolean  @default(false)
  /// One-line pitch and the feature bullets shown on the plan card.
  tagline           String?
  features          Json     @default("[]")
  sortOrder         Int      @default(0)
  active            Boolean  @default(true)
  updatedAt         DateTime @updatedAt
}

/// Phase S: Klingit's team, sold as packs of PM and creative credits (EUR per month for the team part; the
/// Enterprise platform fee comes on top). "Per request" has no fixed numbers: staff set them on the contract.
model TeamPack {
  key             String   @id // pm10 | pm20 | pm40 | pmc10_20 | pmc20_40 | pmc40_80 | per_request
  name            String
  pmCredits       Int      @default(0)
  creativeCredits Int      @default(0)
  priceEur        Float?
  perRequest      Boolean  @default(false)
  /// The platform plan a pack needs (Enterprise for every pack).
  requiresPlanKey String   @default("enterprise")
  sortOrder       Int      @default(0)
  active          Boolean  @default(true)
  updatedAt       DateTime @updatedAt
}

/// Phase S: units of a currency per 1 EUR (staff-editable). Converted price = EUR × rate × 1.02, rounded to 5.
model FxRate {
  currency        String   @id // SEK | NOK | GBP | USD
  perEur          Float
  updatedByUserId String?
  updatedAt       DateTime @updatedAt
}

/// Phase S: a staff override of one converted list price (e.g. Pro in SEK is exactly 1,095).
model PriceOverride {
  id              String   @id @default(cuid())
  /// "plan:<key>" | "pack:<key>"
  ref             String
  currency        String
  amount          Float
  updatedByUserId String?
  updatedAt       DateTime @updatedAt

  @@unique([ref, currency])
}

/// Phase S: a client's contract. One active (or paused / ending) per client; ended ones stay as history. Prices are
/// locked at signing, in the contract's currency, so list price changes never touch a signed client.
model Contract {
  id                      String    @id @default(cuid())
  clientId                String
  /// active | paused | ending | ended
  status                  String    @default("active")
  platformPlanKey         String
  /// A TeamPack key, or null for platform only ("per_request": staff set the credits and price below).
  teamPackKey             String?
  pmCreditsPerMonth       Float     @default(0)
  creativeCreditsPerMonth Float     @default(0)
  termMonths              Int
  startDate               DateTime
  endDate                 DateTime
  /// monthly | quarterly | upfront
  invoicing               String
  currency                String
  /// Per month, in the currency, locked at signing.
  platformPrice           Float
  teamPrice               Float     @default(0)
  /// End date − 2 months: cancel by then, or it renews for the same term.
  noticeDeadline          DateTime
  autoRenew               Boolean   @default(true)
  cancelledAt             DateTime?
  /// The Marketing PM: required when there's a team pack.
  contactStaffId          String?
  pausedFrom              DateTime?
  pausedDays              Int       @default(0)
  /// Extra active projects bought on top of what the creative credits give (each 10% of the team price).
  extraSlots              Int       @default(0)
  signedAt                DateTime  @default(now())
  createdByUserId         String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  client  Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  contact StaffMember?     @relation("ContractContact", fields: [contactStaffId], references: [id])
  changes ContractChange[]

  @@index([clientId, status])
}

/// Every change to a contract, in order: created, upgrade, downgrade, pause, resume, renewed, cancelled, ended,
/// contact. Upgrades and downgrades are scheduled (effectiveFrom later than createdAt) and applied when due.
model ContractChange {
  id            String    @id @default(cuid())
  contractId    String
  kind          String
  /// scheduled | applied | cancelled
  status        String    @default("applied")
  effectiveFrom DateTime
  /// An upgrade's end: the contract goes back to `before` then.
  until         DateTime?
  before        Json?
  after         Json?
  note          String?
  byUserId      String?
  createdAt     DateTime  @default(now())

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([contractId, status, effectiveFrom])
}

/// Phase S: a fixed-credit monthly service (Performance via Druce, the web retainer…): its credits are reserved
/// from the creative balance on the first of each month for `months` months, never roll over, and show as their own
/// line in Usage. Sold inside the pack (from its credits) or outside it (then invoiced on its own line).
model ServiceAllocation {
  id              String    @id @default(cuid())
  clientId        String
  priceListItemId String?
  name            String
  creditsPerMonth Float
  startDate       DateTime
  months          Int
  /// Sold outside the pack: invoiced on its own line instead of taken from the pack's credits.
  outsidePack     Boolean   @default(false)
  endedAt         DateTime?
  createdByUserId String?
  createdAt       DateTime  @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
}

/// Phase S: who and how to invoice. Admins on the client edit it; staff set payment terms and VAT.
model BillingProfile {
  clientId               String   @id
  company                String?
  orgNumber              String?
  vatNumber              String?
  address                String?
  country                String   @default("SE")
  invoiceEmail           String?
  reference              String?
  eInvoiceAddress        String?
  paymentTermsDays       Int      @default(30)
  /// 0.25 for Sweden; 0 for reverse charge abroad. Staff-set.
  vatRate                Float    @default(0.25)
  /// AI credit top-ups up to this price are approved without staff (null: always ask).
  aiTopUpAutoApproveUpTo Float?
  updatedAt              DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

/// Phase S: something to bill on the client's next invoice (an approved extra pack, an AI top-up, a service sold
/// outside the pack). invoiceId is set when it lands on an invoice.
model BillingItem {
  id          String   @id @default(cuid())
  clientId    String
  kind        String
  description String
  quantity    Float    @default(1)
  unitPrice   Float
  amount      Float
  currency    String
  requestId   String?
  invoiceId   String?
  createdAt   DateTime @default(now())

  client  Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  invoice Invoice? @relation(fields: [invoiceId], references: [id])

  @@index([clientId, invoiceId])
}

/// Phase S: everything a client buys or changes is a request: they see the price and the rule, staff approve, the
/// change applies and the line goes on the next invoice. AI top-ups can be auto-approved up to a set price.
model PurchaseRequest {
  id                String    @id @default(cuid())
  clientId          String
  /// creative_pack | ai_topup | extra_slot | plan_change | pause | per_request
  kind              String
  payload           Json      @default("{}")
  /// The price the client saw, in their contract's currency (per month for slots and plan changes).
  price             Float?
  currency          String    @default("EUR")
  /// pending | approved | declined
  status            String    @default("pending")
  requestedByUserId String?
  decidedByUserId   String?
  decidedAt         DateTime?
  decisionNote      String?
  createdAt         DateTime  @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([clientId, status])
}

/// Phase T: a Today task a staff member finished (acted on it) or ticked off, per day. A ticked task stays done for
/// the rest of that day and comes back the next day if it's still open.
model TodayDone {
  id        String   @id @default(cuid())
  staffId   String
  taskKey   String
  /// YYYY-MM-DD in the staff member's day.
  day       String
  /// "acted" (its action was done) or "ticked".
  how       String
  /// The task's sentence when it was done, for "3 done today: …".
  label     String
  clientId  String?
  createdAt DateTime @default(now())

  @@unique([staffId, taskKey, day])
  @@index([staffId, day])
}

/// Phase U: the client's general conversation with their Marketing PM (not about one project). A message about a
/// project is that project's Comment instead; the message panel shows both.
model ClientMessage {
  id                 String    @id @default(cuid())
  clientId           String
  authorUserId       String?
  authorClientUserId String?
  body               String
  attachments        Json?
  archivedAt         DateTime?
  createdAt          DateTime  @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, createdAt])
}

/// Phase U: read state of a client's message thread, per person (client users and staff).
model PmThreadRead {
  id         String   @id @default(cuid())
  userId     String
  clientId   String
  lastReadAt DateTime

  @@unique([userId, clientId])
}

/// Phase U: how a piece did when there's no channel data ("Printed: 2,000", "Shared with 3 retailers"), added by the
/// client or their PM (or counted, e.g. downloads). Shown in the Output library and in Insights.
model OutputFact {
  id              String   @id @default(cuid())
  clientId        String
  assetId         String?
  skillOutputId   String?
  label           String
  value           Float?
  note            String?
  /// "client" | "staff" | "auto"
  source          String   @default("client")
  createdByUserId String?
  createdAt       DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, createdAt])
  @@index([assetId])
}

/// Phase U: work sent through Anthropic's Batch API (scheduled reports): submitted, then collected by the scheduler.
model AiBatchJob {
  id          String    @id @default(cuid())
  batchId     String    @unique
  kind        String
  payload     Json
  status      String    @default("submitted")
  error       String?
  createdAt   DateTime  @default(now())
  completedAt DateTime?
}
