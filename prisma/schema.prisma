  variant       String? // e.g. "Primary", "Reversed / white", "Icon mark"
  format        String? // e.g. "SVG", "PNG", "PDF"
  fileUrl       String?
  previewColor  String             @default("var(--avatar-3)")
  dimensions    String? // e.g. "1800 x 1800"
  fileSizeLabel String? // e.g. "1 MB"
  colorSpace    String? // e.g. "RGB"
  createdAt     DateTime           @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

enum CustomAppStatus {
  ACTIVE
  ARCHIVED
}

// A small hosted tool (built elsewhere, e.g. on the internal micro-apps
// platform) that Ops publishes to one specific client — the client sees it
// under their own "Custom Apps" tab with an outbound link. This is a
// registry/publishing record only; it doesn't build or host anything itself.
model ClientApp {
  id               String          @id @default(cuid())
  clientId         String
  name             String
  slug             String?
  description      String?
  hostedUrl        String
  status           CustomAppStatus @default(ACTIVE)
  createdByStaffId String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  client         Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdByStaff StaffMember? @relation(fields: [createdByStaffId], references: [id], onDelete: SetNull)

  @@index([clientId])
}

model MarketSignal {
  id          String    @id @default(cuid())
  clientId    String
  type        String // COMPETITOR, TREND, MARKET
  title       String
  summary     String
  source      String?
  relevance   String    @default("Watch") // "High relevance", "Relevant", "Watch"
  publishedAt DateTime
  // Identifies "the same alert" across checks (e.g. perf:LinkedIn:<campaignId>)
  // so a still-ongoing condition isn't re-raised on every refresh.
  dedupeKey   String?
  archivedAt  DateTime? // soft delete — hidden from feeds, kept for restore
  /// Structured numbers behind a signal, e.g. {before, after} CTR for a performance alert (the mini before→after).
  data        Json?

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, dedupeKey])
}

model Inspiration {
  id             String    @id @default(cuid())
  clientId       String
  title          String
  description    String
  formatTags     Json?
  thumbnailColor String    @default("var(--avatar-5)")
  targetDate     DateTime? // the moment this idea is tied to, if any (e.g. a seasonal date)
  leadTimeDays   Int       @default(21) // typical production lead time, for "start by" calendar suggestions
  createdAt      DateTime  @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

// OAuth-connected ad platform credentials (currently LinkedIn) — Meta uses a
// static long-lived System User token in env vars instead, so it has no row
// here. One row per provider, refreshed in place as tokens rotate.
/// A platform-level ad account connection (LinkedIn, Google Ads). It belongs to ONE client: only that client's
/// Insights and assistants ever read it (src/lib/integrations/live-ads-owner.ts). clientId null = falls back to
/// LIVE_ADS_CLIENT_ID; neither set = nobody reads it.
model IntegrationConnection {
  id           String    @id @default(cuid())
  provider     String    @unique // "linkedin"
  clientId     String?
  /// Phase T: Klingit's own account ("Mark internal" in Admin): feeds no client and leaves every list.
  internal     Boolean   @default(false)
  accessToken  String
  refreshToken String?
  expiresAt    DateTime?
  connectedAt  DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

enum SendChannelType {
  SLACK
  TEAMS
  EMAIL
}

// A client-side "we've connected X" record — NOT a real OAuth integration
// (no tokens, no live API calls). Lets a client point briefs/reports at a
// Slack channel, Teams channel, or email distribution list they've told us
// about, so "send this to the team" is one click instead of a manual export.
model ConnectedChannel {
